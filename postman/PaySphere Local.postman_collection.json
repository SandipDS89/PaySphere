  "item": [
    {
      "name": "POST Register - Valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has success message\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.message).to.eql(\"Registration successful.\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains a user id\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.user).to.have.property(\"id\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
